# Frontend (the browser connects directly to the API/WebSocket)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/live

# Backend
DATABASE_URL=postgresql+asyncpg://gridpulse:gridpulse_dev@localhost:5432/gridpulse
# Optional public PGCB endpoint returning JSON, CSV, or a readable HTML table.
GRID_SOURCE_URL=
GRID_SOURCE_POLL_SECONDS=3600
GRID_SOURCE_TIMEZONE=Asia/Dhaka
GRID_NATIONAL_BASELINE_DEMAND_MW=15000
GRID_PERSIST_INTERVAL_SECONDS=300
# Optional. Keep this secret on the backend; never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
GRID_TICK_SECONDS=3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
